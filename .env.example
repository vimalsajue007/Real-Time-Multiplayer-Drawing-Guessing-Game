# ---- MySQL (used by docker-compose) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=drawguess
MYSQL_USER=drawguess
MYSQL_PASSWORD=change-me

# ---- Backend ----
# Compose builds DATABASE_URL from the MYSQL_* values above. For running the backend
# directly on your machine, set it yourself (backend/.env or this file):
DATABASE_URL=mysql+pymysql://drawguess:change-me@localhost:3306/drawguess
# Signs player session tokens. Use a long random value: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Game settings (seconds unless noted) ----
MIN_PLAYERS=2
MAX_PLAYERS=8
DEFAULT_ROUNDS=3
MAX_ROUNDS=10
ROUND_SECONDS=80
RESULT_SECONDS=8
DRAWER_GRACE_SECONDS=10
RECONNECT_GRACE_SECONDS=60
LOBBY_GRACE_SECONDS=30
FINISHED_ROOM_TTL_SECONDS=300
WS_MAX_MESSAGE_BYTES=16384
WS_RATE_LIMIT_MESSAGES=400
MAX_STROKE_POINTS_STORED=50000
